# webapp/infra/docker/Dockerfile.api
FROM python:3.12-slim

# Unbuffered stdout/stderr. Without this, Python buffers when not attached to
# a tty, so print() output sits in the buffer and `docker logs` shows nothing
# until the buffer flushes or the process exits. The observability providers
# and the retry paths in llm_service report through print(), so during an
# incident the logs lag behind what the container is actually doing.
ENV PYTHONUNBUFFERED=1

# curl is needed by the entrypoint to wait for / init CouchDB
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install from the lock, not from requirements.txt. requirements.txt states
# constraints; requirements.lock states the exact resolved tree, transitive
# dependencies included. Installing from constraints means a rebuild can
# silently re-resolve a transitive dependency -- which is how a pydantic
# minor release took the API down for 24h on 2026-10-22.
COPY requirements.lock .
RUN pip install --no-cache-dir --root-user-action=ignore --upgrade pip \
    && pip install --no-cache-dir --root-user-action=ignore -r requirements.lock

COPY . .

# Add the entrypoint wrapper that handles CouchDB wait + init
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
# Default command (overridden by docker-compose for local dev)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips=*", "--timeout-keep-alive", "3600", \
     "--workers", "4"]
